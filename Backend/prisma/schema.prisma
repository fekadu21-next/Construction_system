generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id                      String    @id @default(uuid())
  fullName                String
  email                   String    @unique
  passwordHash            String
  roleId                  String
  isActive                Boolean   @default(true)
  phone                   String?
  emailVerifiedAt         DateTime?
  emailVerificationToken   String?
  emailVerificationExpiresAt DateTime?
  mustChangePassword      Boolean   @default(false)
  profilePhotoUrl         String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  role                 Role              @relation(fields: [roleId], references: [id])
  refreshSessions      RefreshSession[]
  passwordResetTokens  PasswordResetToken[]
  createdBy            User?             @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers         User[]            @relation("UserCreator")
  managedProjects      Project[]         @relation("ProjectManager")
  createdProjects      Project[]         @relation("ProjectCreator")
  auditLogs            AuditLog[]

  @@index([roleId])
  @@index([isActive])
  @@index([emailVerificationToken])
  @@index([createdById])
  @@map("users")
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedBySessionId String?   @unique
  userAgent          String?
  ipAddress          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id])
  replaces     RefreshSession? @relation("SessionReplacement")

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Project {
  id                String    @id @default(uuid())
  projectName       String
  projectCode       String    @unique
  description       String?
  location          String
  startDate         DateTime
  endDate           DateTime?
  budget            Decimal   @db.Decimal(15, 2)
  currency          String    @default("ETB")
  status            ProjectStatus @default(PLANNED)
  projectManagerId  String?
  createdById       String
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projectManager User?            @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdBy       User            @relation("ProjectCreator", fields: [createdById], references: [id])

  employees         Employee[]

  @@index([projectManagerId])
  @@index([createdById])
  @@index([status])
  @@index([archivedAt])
  @@map("projects")
}

model Employee {
  id                String         @id @default(uuid())
  employeeCode      String         @unique
  fullName          String
  phone             String
  email             String?
  trade             String         // CARPENTER, MASON, ELECTRICIAN, etc.
  employmentType    String         @default("DAILY_LABORER") // FULL_TIME, CONTRACT, DAILY_LABORER
  dailyRate         Decimal?       @db.Decimal(10, 2)
  monthlySalary     Decimal?       @db.Decimal(10, 2)
  currency          String         @default("ETB")
  status            String         @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  nationalId        String?
  assignedProjectId String?
  assignedProject   Project?       @relation(fields: [assignedProjectId], references: [id], onDelete: SetNull)
  attendanceLogs    Attendance[]
  leaveRequests     LeaveRequest[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([trade])
  @@index([status])
  @@index([assignedProjectId])
  @@map("employees")
}

model Attendance {
  id            String    @id @default(uuid())
  employeeId    String
  projectId     String?
  date          DateTime  @db.Date
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LATE
  overtimeHours Decimal   @default(0.00) @db.Decimal(4, 2)
  notes         String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([projectId])
  @@index([date])
  @@map("attendances")
}

model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String
  leaveType    String    // ANNUAL, SICK, EMERGENCY, UNPAID
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerNote String?
  reviewedById String?
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime  @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Notification {
  id              String   @id @default(uuid())
  recipientRole   String?
  recipientUserId String?
  title           String
  message         String
  type            String   @default("INFO") // INFO, WARNING, SUCCESS, ACTION
  category        String   @default("GENERAL") // LEAVE, ATTENDANCE, WORKFORCE, PAYROLL
  link            String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([recipientRole])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

